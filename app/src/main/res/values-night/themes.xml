<resources>
    <style name="Theme.UMoney" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_dark_theme</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary_dark_theme</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/background_color_dark</item>
        <item name="colorSurface">@color/surface_color_dark</item>
        <item name="colorOnBackground">@color/text_color_dark</item>
        <item name="colorOnSurface">@color/text_color_dark</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/black</item>
        
        <!-- Text colors -->
        <item name="android:textColor">@color/text_color_dark</item>
        
        <!-- Material Components styles -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog.Dark</item>
    </style>

    <!-- Bottom Sheet Dialog Theme Overlay for Dark Mode -->
    <style name="ThemeOverlay.App.BottomSheetDialog.Dark" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet.Dark</item>
        <item name="android:colorBackground">@color/surface_color_dark</item>
    </style>

    <style name="Widget.App.BottomSheet.Dark" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_color_dark</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <style name="DistributionCard.Dark" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/distribution_card_dark</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="contentPadding">16dp</item>
    </style>
</resources> 