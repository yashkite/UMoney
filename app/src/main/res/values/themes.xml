<resources>
    <!-- Base application theme -->
    <style name="Theme.UMoney" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/background_color</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        
        <!-- Background & Text colors -->
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:textColor">@color/text_color</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.UMoney.Splash" parent="Theme.UMoney">
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Dashboard theme -->
    <style name="Theme.UMoney.Dashboard" parent="Theme.UMoney">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>